# Copy this file to ".env" and fill in your Supabase project values.
# Find them in Supabase → Project Settings → API.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The SERVICE ROLE key (secret). Only ever used here on the on-site machine and
# on Vercel's server side — NEVER in a browser.
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# How often to pull every device, in minutes.
PULL_INTERVAL_MIN=15
