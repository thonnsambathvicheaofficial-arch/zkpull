# Set these in Vercel → Project → Settings → Environment Variables.
# (For local `vercel dev`, copy to .env.local.)

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SERVICE ROLE key — server-side only (Vercel functions). Never exposed to the browser.
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# Late-arrival rule used by reports.
WORK_START=08:00
GRACE_MIN=5
